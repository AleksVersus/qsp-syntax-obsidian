{
	"name": "qsp-syntax-obsidian",
	"version": "2.0.0",
	"description": "This plugin add to your Obsidian storage highlighting of QSP-syntax. (https://obsidian.md)",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint . --ext .ts",
		"test": "node test.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"qsp"
	],
	"author": {
		"name": "Aleks Versus",
		"email": "lex666endless@gmail.com",
		"url": "https://github.com/AleksVersus"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/AleksVersus/qsp-syntax-obsidian"
	},
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@types/node": "^22.15.0",
		"@typescript-eslint/eslint-plugin": "8.46.4",
		"@typescript-eslint/parser": "8.46.4",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^8.57.0",
		"obsidian": "1.14.4",
		"prismjs": "1.30.0",
		"tslib": "^2.9.1",
		"typescript": "^5.8.3"
	}
}
