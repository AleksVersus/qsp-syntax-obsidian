# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
# vscode
.vscode 

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
# Intellij
*.iml
.idea

# Runtime data
pids
*.pid
*.seed
*.pid.lock
# npm
node_modules

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov
# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
/main.js

# Coverage directory used by tools like istanbul
coverage
*.lcov
# Exclude sourcemaps
*.map

# nyc test coverage
.nyc_output
# Obsidian vault user data (local)
.obsidian/app.json
.obsidian/appearance.json
.obsidian/core-plugins.json
.obsidian/community-plugins.json
.obsidian/hotkeys.json
.obsidian/workspace.json

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt
# Third-party plugins installed in the vault (not part of this plugin)
.obsidian/plugins/shortcuts-extender/
.obsidian/plugins/obsidian-better-link-inserter-1/

# Bower dependency directory (https://bower.io/)
bower_components
# .obsidian/plugins/qsp-syntax-obsidian/ отслеживается (не игнорируется)

# node-waf configuration
.lock-wscript
# Exclude macOS Finder (System Explorer) View States
.DS_Store

# local tes of md files in project
**/_hist/

# Dependency directories
node_modules/
jspm_packages/
# Kilo agent config (local)
.kilo/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/
# npm config (may contain auth tokens)
.npmrc

# TypeScript cache
*.tsbuildinfo
# Sublime Text (local IDE state)
*.sublime-workspace
*.sublime-project
